# Theme
theme = catppuccin-macchiato.conf

# Font
font-family = JetBrains Mono
font-size = 16

# Visual
background-blur = true
background-opacity = 0.95
background-blur-radius = 20
window-padding-x = 5
window-padding-y = 5
window-theme = ghostty

# Shell
shell-integration = zsh

# Keybindings - Terminal control characters
keybind = ctrl+m=text:\r
keybind = ctrl+i=text:\t
keybind = ctrl+[=text:\x1b
keybind = shift+enter=text:\x1b\r

# Keybindings - Emacs compatibility
keybind = ctrl+backspace=text:\x1b\x7f

# Keybindings - Clipboard (override default ctrl+shift)
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

# Behavior
wait-after-command = true
abnormal-command-exit-runtime = 250
quit-after-last-window-closed = false

# Platform overrides, loaded after everything above so they win. Exactly one of
# these exists on any machine: the platform files live in their own stow
# packages (ghostty-linux, ghostty-macos) precisely so the wrong one cannot be
# linked in. The ? prefix makes the absent one non-fatal.
config-file = ?config_macos
config-file = ?config_linux
