#!/usr/bin/env bash

set -euo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly YELLOW='\033[0;33m'
readonly NO_COLOR='\033[0m'

# Tab-delimited because git forbids control characters in refnames, so no
# branch name can contain one. Using a legal character such as @ splits names
# like "feature@v2" across columns.
readonly REF_FORMAT='%(objectname:short)%09%(refname:short)%09%(committerdate:relative)'

# Determine the main branch: prefer origin's default, fall back to main/master.
main_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || true)
if [ -z "$main_branch" ]; then
    for candidate in main master; do
        if git show-ref --verify --quiet "refs/heads/$candidate"; then
            main_branch="$candidate"
            break
        fi
    done
fi
if [ -z "$main_branch" ]; then
    echo "Could not determine main branch (no origin/HEAD, no local main or master)" >&2
    exit 1
fi

headers=("Ahead" "Behind" "Branch" "Last Commit")
widths=("${#headers[0]}" "${#headers[1]}" "${#headers[2]}" "${#headers[3]}" 0)

aheads=()
behinds=()
branches=()
times=()
descriptions=()

# Collect rows first so columns can be sized to their widest contents.
while IFS=$'\t' read -r sha branch time; do
    if [ "$branch" = "$main_branch" ]; then
        continue
    fi

    # left..right is base-only..branch-only, so left is behind and right ahead.
    read -r behind ahead < <(git rev-list --left-right --count "$main_branch...$sha")

    description=$(git config "branch.$branch.description" || true)
    # Descriptions are free-form and may span lines; the table shows the first.
    description=${description%%$'\n'*}

    aheads+=("$ahead")
    behinds+=("$behind")
    branches+=("$branch")
    times+=("$time")
    descriptions+=("$description")

    [ "${#ahead}" -gt "${widths[0]}" ] && widths[0]=${#ahead}
    [ "${#behind}" -gt "${widths[1]}" ] && widths[1]=${#behind}
    [ "${#branch}" -gt "${widths[2]}" ] && widths[2]=${#branch}
    [ "${#time}" -gt "${widths[3]}" ] && widths[3]=${#time}
    [ "${#description}" -gt "${widths[4]}" ] && widths[4]=${#description}
done < <(git for-each-ref --sort=-authordate --format="$REF_FORMAT" --no-merged="$main_branch" refs/heads/)

if [ "${#branches[@]}" -eq 0 ]; then
    echo "No branches with unmerged work relative to $main_branch"
    exit 0
fi

# Only render the description column when at least one branch has a description.
if [ "${widths[4]}" -gt 0 ]; then
    headers+=("Description")
    desc_fmt=" ${NO_COLOR}%-${widths[4]}s"
else
    desc_fmt=""
fi

row_format="${GREEN}%-${widths[0]}s ${RED}%-${widths[1]}s ${BLUE}%-${widths[2]}s ${YELLOW}%-${widths[3]}s${desc_fmt}${NO_COLOR}\n"

make_divider() { printf '%*s' "$1" '' | tr ' ' '-'; }

# shellcheck disable=SC2059 # row_format is built here, never from branch data
printf "$row_format" "${headers[@]}"

dividers=(
    "$(make_divider "${widths[0]}")"
    "$(make_divider "${widths[1]}")"
    "$(make_divider "${widths[2]}")"
    "$(make_divider "${widths[3]}")"
)
[ "${widths[4]}" -gt 0 ] && dividers+=("$(make_divider "${widths[4]}")")
# shellcheck disable=SC2059
printf "$row_format" "${dividers[@]}"

for i in "${!branches[@]}"; do
    # shellcheck disable=SC2059
    if [ "${widths[4]}" -gt 0 ]; then
        printf "$row_format" "${aheads[$i]}" "${behinds[$i]}" "${branches[$i]}" "${times[$i]}" "${descriptions[$i]}"
    else
        printf "$row_format" "${aheads[$i]}" "${behinds[$i]}" "${branches[$i]}" "${times[$i]}"
    fi
done
